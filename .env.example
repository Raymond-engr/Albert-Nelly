# Site
NEXT_PUBLIC_WA_NUMBER=2340000000000        # digits only, with country code (no +)
NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com
NEXT_PUBLIC_SOCIAL_HANDLE=@albertnelly
SITE_URL=http://localhost:3000             # Base URL for staff invite, password reset & unsubscribe redirects

# Supabase (leave empty to run in demo mode: the site works, static fallback data is served)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=      # legacy "anon" key also works here
SUPABASE_SECRET_KEY=                       # server only. Legacy "service_role" key also works. Never prefix with NEXT_PUBLIC_

# Email (Phase 7)
RESEND_API_KEY=                            # Transactional email provider API key (server only)
EMAIL_FROM=Albert Nelly <hello@yourdomain.com> # Default sender name & address
EMAIL_WEBHOOK_SECRET=                      # Secret for validating provider webhook signatures (server only)
UNSUBSCRIBE_SECRET=                        # Secret key for HMAC-signing one-click unsubscribe links (server only)
CRON_SECRET=                               # Bearer token guarding /api/cron/* background endpoints (server only)

# Error Tracking & Rate Limiting (Phase 9)
SENTRY_DSN=                                # Optional: Sentry project DSN for error forwarding (server only). Leave empty to log to stdout only.
RATE_LIMIT_MAX=10                          # Optional: max requests per IP per window for POST /api/leads (default: 10)
RATE_LIMIT_WINDOW_MS=60000                 # Optional: sliding-window size in ms for POST /api/leads (default: 60000 = 1 minute)

# Initial Staff Owner Seed (Optional: used when bootstrapping owner via seed script)
# SEED_OWNER_EMAIL=
# SEED_OWNER_PASSWORD=
# SEED_OWNER_NAME=

# Development only: pin the animation mode to test it (full | light | still). Leave empty to adapt to the network.
# Production builds ignore it. Best kept in .env.development.local so it never reaches a deploy.
NEXT_PUBLIC_MOTION_MODE=
